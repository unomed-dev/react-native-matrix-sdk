diff --git a/crates/matrix-sdk/Cargo.toml b/crates/matrix-sdk/Cargo.toml
index fe4e3da..dd66fd3 100644
--- a/crates/matrix-sdk/Cargo.toml
+++ b/crates/matrix-sdk/Cargo.toml
@@ -160,13 +160,15 @@ zeroize.workspace = true
 backon = "1.6.0"
 # only activate reqwest's stream feature on non-wasm, the wasm part seems to not
 # support *sending* streams, which makes it useless for us.
-reqwest = { workspace = true, features = ["stream", "gzip", "http2", "rustls"] }
+reqwest = { workspace = true, features = ["stream", "gzip", "http2", "rustls-no-provider"] }
+# Provider for reqwest's rustls-no-provider, on every non-wasm target (iOS included).
+rustls = { version = "0.23.38", default-features = false, features = ["ring", "logging", "std", "tls12"] }
 tokio = { workspace = true, features = ["fs", "rt", "macros"] }
 wiremock = { workspace = true, optional = true }
 
 [target.'cfg(target_family = "wasm")'.dependencies]
 gloo-timers = { workspace = true, features = ["futures"] }
-reqwest = { workspace = true, features = ["gzip", "http2", "rustls"] }
+reqwest = { workspace = true, features = ["gzip", "http2", "rustls-no-provider"] }
 tokio = { workspace = true, features = ["macros"] }
 
 [dev-dependencies]
@@ -196,7 +198,7 @@ wiremock.workspace = true
 wasm-bindgen-test.workspace = true
 
 [target.'cfg(target_os = "android")'.dependencies]
-rustls = "0.23.38"
+rustls = { version = "0.23.38", default-features = false, features = ["ring", "logging", "std", "tls12"] }
 rustls-pki-types = "1.14.0"
 rustls-native-certs = "0.8.3"
 webpki-roots = "1.0.6"
diff --git a/crates/matrix-sdk/src/http_client/native.rs b/crates/matrix-sdk/src/http_client/native.rs
index a02455f..da21e75 100644
--- a/crates/matrix-sdk/src/http_client/native.rs
+++ b/crates/matrix-sdk/src/http_client/native.rs
@@ -185,6 +185,11 @@ impl Default for HttpSettings {
 impl HttpSettings {
     /// Build a client with the specified configuration.
     pub(crate) fn make_client(&self) -> Result<reqwest::Client, HttpError> {
+        // reqwest's `rustls-no-provider` feature leaves the process-wide rustls
+        // provider unset, so every request would fail with "No provider set".
+        // Install ring once; an error only means a provider is already installed.
+        let _ = rustls::crypto::ring::default_provider().install_default();
+
         let user_agent = self.user_agent.clone().unwrap_or_else(|| "matrix-rust-sdk".to_owned());
         let mut http_client = reqwest::Client::builder()
             .user_agent(user_agent)
